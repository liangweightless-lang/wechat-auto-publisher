# ==========================================
# 微信公众号配置 (必填)
# 获取地址：微信公众平台 / 微信开发者平台 -> 开发管理 -> 基本配置
# ==========================================
WECHAT_APPID=your_wechat_appid_here
WECHAT_APPSECRET=your_wechat_appsecret_here

# 默认文章作者署名（例如：舆情洞见编辑部）
WECHAT_DEFAULT_AUTHOR=舆情洞见

# ==========================================
# 大语言模型配置 (必填，用于深度改写与舆情分析)
# 支持兼容 OpenAI 标准格式的各类服务，如 DeepSeek、Kimi、通义千问等
# ==========================================
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ==========================================
# 移动端消息推送配置 (选填，支持任务完成手机通知)
# 推荐 PushPlus (http://www.pushplus.plus/) 关注即可微信弹窗
# 或 Server酱 (https://sct.ftqq.com/)
# ==========================================
PUSHPLUS_TOKEN=
SERVERCHAN_KEY=
WECHAT_WORK_WEBHOOK=
